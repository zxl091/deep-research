# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# All research roles, chat, memory and Text2SQL share this model ID. Restart backend after editing.
OPENAI_MODEL=qwen3.7-flash

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 博查搜索 API（必填）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# Docker 默认配置，与 docker-compose.yml 保持一致
# 如果使用 Docker，无需修改以下配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=industry_assistant

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 生成的 Python 分析代码仅在此 Docker 镜像中执行；须事先构建，不会自动拉取。
RESEARCH_SANDBOX_IMAGE=industry-research-sandbox:local

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440


# Model request deadline (seconds); complete research has no total time limit.
RESEARCH_MODEL_CALL_TIMEOUT_SECONDS=600
RESEARCH_ENABLE_THINKING=false
